<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row: Icon, Title, Percentage Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_speaker_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_widget_unmute" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pastel Volume"
                android:textColor="#2E2836"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Media Sound"
                android:textColor="#7A7285"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_percent_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_button"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="65%"
            android:textColor="#2E2836"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Horizontal Volume Progress Track -->
    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:max="100"
        android:progress="65"
        android:progressDrawable="@drawable/widget_progress_track" />

    <!-- Controls Row: Mute, Minus, Plus, Presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Mute/Unmute Toggle -->
        <ImageButton
            android:id="@+id/widget_btn_mute"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_pill_button"
            android:contentDescription="Mute or Unmute"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_unmute" />

        <!-- Volume Down (-10%) -->
        <ImageButton
            android:id="@+id/widget_btn_down"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_button"
            android:contentDescription="Volume Down"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_minus" />

        <!-- Volume Up (+10%) -->
        <ImageButton
            android:id="@+id/widget_btn_up"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_button"
            android:contentDescription="Volume Up"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_add" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Preset 25% -->
        <Button
            android:id="@+id/widget_preset_25"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_pill_button_subtle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="25%"
            android:textColor="#52485E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Preset 70% -->
        <Button
            android:id="@+id/widget_preset_70"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_pill_button_subtle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="70%"
            android:textColor="#52485E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Preset 100% -->
        <Button
            android:id="@+id/widget_preset_max"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_pill_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="MAX"
            android:textColor="#2E2836"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
